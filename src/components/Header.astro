---
interface Props {
  /** When false, the wordmark is plain text (used on the landing page itself). */
  linked?: boolean;
}
const { linked = false } = Astro.props;
---

<header class="page header spread">
  <div class="header__bar">
    {
      linked ? (
        <a href="/" class="header__wordmark">Flux <span class="amp">&amp;</span> Form</a>
      ) : (
        <span class="header__wordmark">Flux <span class="amp">&amp;</span> Form</span>
      )
    }
    <p class="mono label header__meta">Columbus, OH&nbsp;/&nbsp;Est. 2025</p>
  </div>
</header>

<style>
  /* The header bar spans frame edge → content's right edge (like the footer), so
     the meta line shares the content's right edge. */
  .header__bar {
    grid-column: label / edge;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .header__wordmark {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }

  .header__wordmark .amp {
    font-weight: 400;
    /* the ampersand carries the only bit of flourish in the wordmark */
    margin-inline: 0.05em;
  }

  .header__meta {
    /* renders uppercase via .label -> "COLUMBUS, OH / EST. 2025" (BRIEF §4/§7) */
    color: var(--muted);
  }
</style>
