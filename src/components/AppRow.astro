---
import type { App } from '../lib/apps';
import { statusBadge, appCta } from '../lib/apps';

interface Props {
  app: App;
  /** Link the app name to its detail page. */
  linked?: boolean;
}

const { app, linked = true } = Astro.props;
const badge = statusBadge(app.status);
const cta = appCta(app);
---

<article class="app">
  <div class="app__head">
    <!-- one small colour mark per app (BRIEF §5); its only source of colour -->
    <span class="app__chip" style={`--accent:${app.accent}`} aria-hidden="true"></span>
    <h3 class="app__name">
      {linked ? <a href={`/${app.slug}`}>{app.name}</a> : app.name}
    </h3>
    <span class="mono label app__badge">{badge}</span>
  </div>

  <p class="app__blurb">{app.blurb}</p>

  {
    cta && (
      <a class="mono app__cta" href={cta.href}>
        {cta.label}
      </a>
    )
  }
</article>

<style>
  .app {
    /* one source of truth for the name size; the chip is scaled from it */
    --app-name-size: 1.5rem;
    padding-block: clamp(1.4rem, 3vw, 2rem);
  }

  /* lighter rule between items within a section (BRIEF §5) */
  .app + .app {
    border-top: 1px solid var(--rule-hair);
  }

  .app:first-child {
    padding-top: 0;
  }

  /* last item adds no trailing space, so the gap to the next section is the
     section-gap alone — no doubling */
  .app:last-child {
    padding-bottom: 0;
  }

  .app__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
  }

  .app__chip {
    /* square scaled to the cap-height of the app name beside it, baseline-aligned
       so it reads as a typographic mark, not a bullet. One mark per app. */
    font-size: var(--app-name-size);
    inline-size: 0.72em; /* ≈ cap height of the system sans */
    block-size: 0.72em;
    background: var(--accent);
    /* square, no radius — no rounded boxes anywhere (BRIEF §5) */
    flex: none;
    align-self: baseline;
  }

  .app__name {
    font-family: var(--font-sans);
    /* one step larger than the house-rules headings (1.2rem) so the two
       sections aren't structurally interchangeable (stays in the sans — Fraunces
       is the hero's alone) */
    font-size: var(--app-name-size);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
    margin-right: auto; /* push the badge to the right edge */
    color: var(--ink);
  }

  .app__name a {
    color: inherit;
    text-decoration: none;
  }

  .app__name a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .app__badge {
    align-self: center;
    /* Same muted as the other mono labels — secondary status metadata, ~6.6:1
       on paper (well past WCAG AA), lighter than the app name beside it. */
    color: var(--muted);
    white-space: nowrap;
  }

  .app__blurb {
    margin-top: 0.6rem;
    max-width: var(--measure-text);
    color: var(--ink);
  }

  .app__cta {
    display: inline-block;
    margin-top: 0.9rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.1rem;
  }

  .app__cta::after {
    content: ' \2192'; /* → */
  }

  .app__cta:hover {
    color: var(--muted);
    border-color: var(--muted);
  }
</style>
