---
import AppLayout from '../layouts/AppLayout.astro';
import { apps, statusBadge, appCta, type App } from '../lib/apps';

// One detail page per app entry, from the data file (BRIEF §2/§6/§8).
// Apps that ship their own hand-built page (public/<slug>/) are skipped here so
// this template doesn't collide with that file — the landing still links to
// /<slug>, which serves the app's own site. Apps on their own domain
// (`siteUrl`) are skipped too — the landing links straight out to them, so this
// site hosts no page for them at all.
export function getStaticPaths() {
  return apps
    .filter((app) => !app.hasSite && !app.siteUrl)
    .map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

interface Props {
  app: App;
}
const { app } = Astro.props;
const badge = statusBadge(app.status);
const cta = appCta(app);
---

<AppLayout
  title={`${app.name} — Flux & Form`}
  description={app.blurb}
  path={`/${app.slug}`}
  slug={app.slug}
>
  <!--
    v1 template: deliberately unpopulated (BRIEF §2) — no screenshots, no
    marketing copy. It exists to prove the structure before the first app ships.
  -->
  <article class="detail spread">
    <div class="detail__inner">
      <div class="detail__head">
        <span
          class="detail__chip"
          style={`--accent:${app.accent}`}
          aria-hidden="true"></span>
        <h1 class="detail__name">{app.name}</h1>
        <span class="mono label detail__badge">{badge}</span>
      </div>

      <p class="detail__blurb">{app.blurb}</p>

      {
        cta && (
          <a class="mono detail__cta" href={cta.href}>
            {cta.label}
          </a>
        )
      }
    </div>
  </article>
</AppLayout>

<style>
  /* One app row, enlarged — chip + name at the content edge, status badge at the
     content's right edge, mirroring the landing's Building list. */
  .detail__inner {
    grid-column: content;
    --app-name-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
  }

  .detail__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
  }

  .detail__chip {
    font-size: var(--app-name-size);
    inline-size: 0.72em; /* cap height of the name beside it */
    block-size: 0.72em;
    background: var(--accent);
    flex: none;
    align-self: baseline;
  }

  .detail__name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--app-name-size);
    line-height: 1.1;
    margin: 0;
    margin-right: auto; /* push the badge to the content's right edge */
    color: var(--ink);
  }

  .detail__badge {
    align-self: center;
    color: var(--muted);
    white-space: nowrap;
  }

  .detail__blurb {
    margin-top: 1.1rem;
    max-width: var(--measure-text);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--ink);
  }

  .detail__cta {
    display: inline-block;
    margin-top: 1.6rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.1rem;
  }
  .detail__cta::after {
    content: ' \2192';
  }
  .detail__cta:hover {
    color: var(--muted);
    border-color: var(--muted);
  }
</style>
